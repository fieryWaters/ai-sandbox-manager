#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="${dir}/${source}" ;;
    esac
  done
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"
REPO_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

DEFAULT_IMAGE="ubuntu:24.04"
DEFAULT_USER="agent"
DEFAULT_PORT_BASE="2230"
DEFAULT_BIND="127.0.0.1"
CONFIG_REL=".ai-sandbox/box.env"
REPO_REL=".ai-sandbox/ai-sandbox-manager"
STATE_DIR="${HOME}/.ai-sandbox"
ARCHIVE_DIR="${STATE_DIR}/archives"
BOX_STATE_DIR="${STATE_DIR}/boxes"
SSH_DIR="${STATE_DIR}/ssh"
SSH_MANAGED_CONFIG="${SSH_DIR}/config"
SSH_CONFIG="${HOME}/.ssh/config"
SSH_KEY_DIR="$SSH_DIR"
SSH_KNOWN_HOSTS="${SSH_DIR}/known_hosts"

log() { printf '[sandbox] %s\n' "$*"; }
warn() { printf '[sandbox][warn] %s\n' "$*" >&2; }
die() { printf '[sandbox][error] %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  sandbox create NAME [--port-base N] [--user USER] [--bind ADDR]
                         [--ssh-bind ADDR] [--novnc-bind ADDR] [--cua-bind ADDR]
                         [--public] [--github] [--from ARCHIVE_OR_NAME]
  sandbox update NAME
  sandbox start NAME
  sandbox stop NAME
  sandbox copy SOURCE DEST [--port-base N] [--bind ADDR]
  sandbox export NAME [FILE]
  sandbox github NAME [--revoke]
  sandbox doctor NAME
  sandbox view NAME
  sandbox ssh NAME [-- COMMAND...]
  sandbox list [NAME]
  sandbox destroy NAME
  sandbox help [COMMAND]

Core defaults:
  --user agent
  --port-base first free block from 2230
  --bind 127.0.0.1

Ports are always contiguous:
  SSH          PORT_BASE
  noVNC        PORT_BASE + 1
  CUA fallback PORT_BASE + 2

Bind addresses:
  127.0.0.1 keeps a service local to Spark.
  0.0.0.0 exposes a service on all host interfaces.
  --public is shorthand for --bind 0.0.0.0.

Host-side state:
  ~/.ai-sandbox/boxes     Host mirror of each box's tiny config.
  ~/.ai-sandbox/ssh       SSH keys, known-hosts, and managed SSH config.
  ~/.ai-sandbox/archives  Default export/import location.

Desktop automation contract:
  Agents use deskbot from the shell, or cua computer-server (port 8000)
  programmatically. Both drive the box's one native desktop. noVNC shows
  that same desktop to humans.
EOF
}

command_help() {
  case "${1:-}" in
    create)
      cat <<'EOF'
sandbox create NAME [options]

Creates an Ubuntu LXD box, writes /home/USER/.ai-sandbox/box.env,
syncs this repo into the VM, installs managed tooling, writes SSH config,
and runs doctor.

With --from, imports an archive instead of launching a clean Ubuntu image.
ARCHIVE_OR_NAME may be an explicit tarball path or a name in
~/.ai-sandbox/archives/NAME.tar.gz. Imported boxes keep their VM state, but
get fresh host ports, fresh host SSH keys, and rewritten managed config.

Options:
  --port-base N       Use N,N+1,N+2 for SSH,noVNC,CUA. Fails if busy.
  --user USER         Runtime user for clean creates. Default: agent.
  --bind ADDR         Bind all host proxies to 127.0.0.1 or 0.0.0.0.
  --ssh-bind ADDR     Bind only SSH host proxy.
  --novnc-bind ADDR   Bind only noVNC host proxy.
  --cua-bind ADDR     Bind only CUA fallback host proxy.
  --public            Bind all services to 0.0.0.0.
  --github            Grant GitHub SSH push access after install.
  --from SOURCE       Import from SOURCE tarball or default archive name.
EOF
      ;;
    update)
      cat <<'EOF'
sandbox update NAME

Repairs an existing box: syncs this checkout into the VM, regenerates
managed proxy devices and SSH config from box.env, runs uninstall-managed,
runs install, and then runs doctor. It preserves user browser/Codex
state and does not migrate the create-time user.
EOF
      ;;
    start)
      cat <<'EOF'
sandbox start NAME

Starts a stopped box, refreshes its managed SSH config from box.env, waits for
basic SSH, and prints the noVNC URL. Run doctor when you want full validation.
EOF
      ;;
    stop)
      cat <<'EOF'
sandbox stop NAME

Stops a box without deleting it. Host-side state, SSH keys, archive files,
box.env, and reserved LXD proxy devices are preserved.
EOF
      ;;
    copy|cp)
      cat <<'EOF'
sandbox copy SOURCE DEST [options]
sandbox cp SOURCE DEST [options]

Copies a stopped sandbox into a new sandbox using LXD. DEST receives a fresh
host SSH key, the next free port block unless --port-base is supplied, and
localhost-only exposure unless bind options are supplied.

Options:
  --port-base N       Use N,N+1,N+2 for SSH,noVNC,CUA. Fails if reserved.
  --bind ADDR         Bind all host proxies to 127.0.0.1 or 0.0.0.0.
  --ssh-bind ADDR     Bind only SSH host proxy.
  --novnc-bind ADDR   Bind only noVNC host proxy.
  --cua-bind ADDR     Bind only CUA fallback host proxy.
  --public            Bind all services to 0.0.0.0.
EOF
      ;;
    export)
      cat <<'EOF'
sandbox export NAME [FILE]

Exports a stopped sandbox with lxc export. Without FILE, writes:

  ~/.ai-sandbox/archives/NAME.tar.gz

The box must be stopped first so the archive is consistent.
EOF
      ;;
    github)
      cat <<'EOF'
sandbox github NAME [--revoke]

Grants a box GitHub SSH push access without placing GitHub tokens in the box.
The box owns its ~/.ssh/id_ed25519 keypair; the host gh CLI registers the
public key on the GitHub account, seeds github.com known_hosts in the box, and
sets the box git identity.

Options:
  --revoke           Delete the recorded GitHub account key and clear state.
EOF
      ;;
    doctor)
      cat <<'EOF'
sandbox doctor NAME

Checks LXD, ports, ssh NAME, noVNC, computer-server /status, Codex login,
Claude auth, GitHub SSH access when granted, the deskbot command surface, real
deskbot screenshot pixels, a Codex-mediated deskbot browser smoke whose trace
must show the canonical deskbot path, and a Claude-mediated deskbot browser
smoke.
EOF
      ;;
    view)
      cat <<'EOF'
sandbox view NAME

Prints only the noVNC URL for the box.
EOF
      ;;
    ssh)
      cat <<'EOF'
sandbox ssh NAME [-- COMMAND...]

Refreshes the managed SSH config block for NAME, then opens an interactive
SSH session or runs COMMAND through that host alias. Managed hosts use
~/.ai-sandbox/ssh/known_hosts with a per-box HostKeyAlias, so reused localhost
ports do not collide with global SSH known-hosts entries.
EOF
      ;;
    list)
      cat <<'EOF'
sandbox list [NAME]

Without NAME, prints a compact overview of current LXD instances.

With NAME, prints the detailed access view for one box: user, private key path,
known-host alias, SSH commands, noVNC URLs, CUA URLs, ports, and bind addresses.
It does not print private key contents.
EOF
      ;;
    destroy)
      cat <<'EOF'
sandbox destroy NAME

Revokes the recorded GitHub account key when granted, deletes the LXD instance,
removes only the matching managed SSH config block, removes that box's unique
SSH keypair from ~/.ai-sandbox/ssh, and removes that box's managed known-hosts
entry.

Destroy requires typing the exact box name at the confirmation prompt.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

ensure_state_dirs() {
  mkdir -p "$STATE_DIR" "$ARCHIVE_DIR" "$BOX_STATE_DIR" "$SSH_DIR"
  chmod 700 "$STATE_DIR" "$ARCHIVE_DIR" "$BOX_STATE_DIR" "$SSH_DIR"
  touch "$SSH_MANAGED_CONFIG"
  chmod 600 "$SSH_MANAGED_CONFIG"
}

remove_managed_ssh_block_from_file() {
  local file="$1"
  local name="$2"
  [ -f "$file" ] || return
  local tmp
  tmp="$(mktemp)"
  awk -v name="$name" '
    $0 == "# >>> ai-sandbox " name { skip=1; next }
    $0 == "# <<< ai-sandbox " name { skip=0; next }
    !skip { print }
  ' "$file" >"$tmp"
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

shell_quote() {
  printf '%q' "$1"
}

ensure_ssh_include() {
  ensure_state_dirs
  mkdir -p "$(dirname "$SSH_CONFIG")"
  touch "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"

  local include_line="Include ${SSH_MANAGED_CONFIG}"
  if ! awk -v wanted_include="$include_line" '
    $0 == wanted_include { found=1 }
    $0 == "Include ~/.ai-sandbox/ssh/config" { found=1 }
    END { exit found ? 0 : 1 }
  ' "$SSH_CONFIG"; then
    local tmp
    tmp="$(mktemp)"
    {
      printf '%s\n' "$include_line"
      cat "$SSH_CONFIG"
    } >"$tmp"
    cat "$tmp" >"$SSH_CONFIG"
    rm -f "$tmp"
  fi
}

validate_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid name: ${name}"
}

validate_user() {
  local user="$1"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || die "Invalid user: ${user}"
}

validate_port_base() {
  local base="$1"
  [[ "$base" =~ ^[0-9]+$ ]] || die "Port base must be numeric: ${base}"
  [ "$base" -ge 1024 ] || die "Port base must be >= 1024"
  [ "$base" -le 65533 ] || die "Port base must be <= 65533"
}

normalize_bind() {
  local bind="$1"
  case "$bind" in
    localhost) printf '127.0.0.1' ;;
    127.0.0.1|0.0.0.0) printf '%s' "$bind" ;;
    *) die "Bind address must be 127.0.0.1, localhost, or 0.0.0.0: ${bind}" ;;
  esac
}

ports_from_base() {
  PORT_BASE="$1"
  SSH_PORT="$PORT_BASE"
  NOVNC_PORT=$((PORT_BASE + 1))
  CUA_PORT=$((PORT_BASE + 2))
}

port_listening() {
  local port="$1"
  ss -H -ltn 2>/dev/null | awk -v suffix=":${port}" '$4 ~ suffix "$" { found=1 } END { exit found ? 0 : 1 }'
}

configured_proxy_port_owner() {
  local port="$1"
  local exclude="${2:-}"
  local name device listen listen_port
  while IFS=, read -r name _status; do
    [ -n "$name" ] || continue
    [ "$name" = "$exclude" ] && continue
    for device in ai-sandbox-ssh ai-sandbox-novnc ai-sandbox-cua; do
      listen="$(device_listen "$name" "$device")"
      [ -n "$listen" ] || continue
      listen_port="$(parse_listen_port "$listen")"
      if [ "$listen_port" = "$port" ]; then
        printf '%s' "$name"
        return
      fi
    done
  done < <(lxc list --format csv -c ns 2>/dev/null)
}

busy_port_in_block() {
  local base="$1"
  local exclude="${2:-}"
  ports_from_base "$base"
  local port
  for port in "$SSH_PORT" "$NOVNC_PORT" "$CUA_PORT"; do
    if port_listening "$port"; then
      printf '%s' "$port"
      return
    fi
    if [ -n "$(configured_proxy_port_owner "$port" "$exclude")" ]; then
      printf '%s' "$port"
      return
    fi
  done
}

port_block_free() {
  local base="$1"
  local exclude="${2:-}"
  [ -z "$(busy_port_in_block "$base" "$exclude")" ]
}

check_port_block_free() {
  local base="$1"
  local exclude="${2:-}"
  local busy
  busy="$(busy_port_in_block "$base" "$exclude")"
  [ -z "$busy" ] || die "Port ${busy} is already listening; choose another --port-base"
}

next_port_block_start() {
  local base="$1"
  local next=$(( ((base / 10) + 1) * 10 ))
  [ "$next" -ge "$DEFAULT_PORT_BASE" ] || next="$DEFAULT_PORT_BASE"
  printf '%s' "$next"
}

find_free_port_base() {
  local base="${1:-$DEFAULT_PORT_BASE}"
  local exclude="${2:-}"
  while [ "$base" -le 65533 ]; do
    if port_block_free "$base" "$exclude"; then
      printf '%s' "$base"
      return
    fi
    base=$((base + 10))
  done
  die "Could not find a free contiguous three-port block"
}

generate_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 18 | tr -d '\n'
  else
    od -An -N18 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

instance_exists() {
  lxc info "$1" >/dev/null 2>&1
}

instance_status() {
  lxc info "$1" 2>/dev/null | awk -F: '/^Status:/ { gsub(/^ +/, "", $2); status=$2 } END { print status }'
}

start_instance() {
  local name="$1"
  if [ "$(instance_status "$name")" = "STOPPED" ]; then
    lxc start "$name"
  fi
}

wait_for_lxc() {
  local name="$1"
  local tries=60
  until lxc exec "$name" -- true >/dev/null 2>&1; do
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] || die "Timed out waiting for ${name}"
    sleep 1
  done
}

set_vm_hostname() {
  local name="$1"
  lxc exec "$name" -- bash -lc "printf '%s\n' '$name' >/etc/hostname && hostname '$name'"
}

reset_cloned_network_identity() {
  local name="$1"
  # LXD archives can preserve the source NIC MAC. If the source still exists,
  # LXD refuses to start the import with "MAC address ... already defined".
  # Clearing it before first boot lets LXD generate a fresh managed MAC.
  lxc config unset "$name" volatile.eth0.hwaddr >/dev/null 2>&1 || true
}

box_config_path() {
  local user="$1"
  printf '/home/%s/%s' "$user" "$CONFIG_REL"
}

host_box_env_path() {
  local name="$1"
  printf '%s/%s.env' "$BOX_STATE_DIR" "$name"
}

repo_dir_for_user() {
  local user="$1"
  printf '/home/%s/%s' "$user" "$REPO_REL"
}

read_box_env() {
  local name="$1"
  # The host mirror is authoritative. The copy inside the box is written by
  # the host for the installer's benefit and is never read back once a mirror
  # exists — an agent with sudo in the box must not be able to change its own
  # exposure. The in-box fallback only adopts boxes that predate mirrors
  # (e.g. imported archives), and those values are validated by load_box_env.
  local host_env
  host_env="$(host_box_env_path "$name")"
  if [ -f "$host_env" ]; then
    cat "$host_env"
    return 0
  fi
  [ "$(instance_status "$name")" != "STOPPED" ] || return 1
  lxc exec "$name" -- bash -lc '
    for path in /home/*/.ai-sandbox/box.env; do
      if [ -f "$path" ]; then
        cat "$path"
        exit 0
      fi
    done
    exit 1
  ' </dev/null 2>/dev/null
}

load_box_env() {
  local name="$1"
  local tmp
  tmp="$(mktemp)"
  if ! read_box_env "$name" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  SANDBOX_USER=""
  PORT_BASE=""
  SSH_BIND=""
  NOVNC_BIND=""
  CUA_BIND=""
  VNC_PASSWORD=""
  GITHUB_SSH_KEY_TITLE=""
  GITHUB_SSH_KEY_FINGERPRINT=""
  GITHUB_SSH_KEY_ID=""
  local line key value
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
      *=*)
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
          SANDBOX_USER|PORT_BASE|SSH_BIND|NOVNC_BIND|CUA_BIND|VNC_PASSWORD|GITHUB_SSH_KEY_TITLE|GITHUB_SSH_KEY_FINGERPRINT|GITHUB_SSH_KEY_ID)
            printf -v "$key" '%s' "$value"
            ;;
        esac
        ;;
    esac
  done <"$tmp"
  rm -f "$tmp"

  SANDBOX_USER="${SANDBOX_USER:-$DEFAULT_USER}"
  PORT_BASE="${PORT_BASE:-}"
  SSH_BIND="${SSH_BIND:-$DEFAULT_BIND}"
  NOVNC_BIND="${NOVNC_BIND:-$DEFAULT_BIND}"
  CUA_BIND="${CUA_BIND:-$DEFAULT_BIND}"
  [ -n "$VNC_PASSWORD" ] || return 1
  [ -n "$PORT_BASE" ] || return 1
  validate_user "$SANDBOX_USER"
  validate_port_base "$PORT_BASE"
  SSH_BIND="$(normalize_bind "$SSH_BIND")"
  NOVNC_BIND="$(normalize_bind "$NOVNC_BIND")"
  CUA_BIND="$(normalize_bind "$CUA_BIND")"
  ports_from_base "$PORT_BASE"
  write_host_box_env "$name" "$SANDBOX_USER" "$PORT_BASE" "$VNC_PASSWORD" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
}

device_listen() {
  local name="$1"
  local device="$2"
  lxc config device get "$name" "$device" listen 2>/dev/null || true
}

parse_listen_port() {
  local listen="$1"
  printf '%s' "$listen" | awk -F: '{ print $NF }'
}

parse_listen_bind() {
  local listen="$1"
  printf '%s' "$listen" | sed -E 's/^tcp:(.*):[0-9]+$/\1/'
}

host_network_interfaces() {
  command -v ip >/dev/null 2>&1 || return
  ip -o -4 addr show scope global up 2>/dev/null | awk '
    function useful_interface(name) {
      return name !~ /^(lo$|docker|br-|lxdbr|incusbr|virbr|veth|cni|flannel|kube|podman)/
    }
    {
      name = $2
      sub(/:$/, "", name)
      split($4, addr, "/")
      if (useful_interface(name) && !seen[addr[1]]++) {
        print name, addr[1]
      }
    }
  '
}

interface_label_for_ip() {
  local ipaddr="$1"
  local label addr
  while read -r label addr; do
    [ -n "$label" ] || continue
    if [ "$addr" = "$ipaddr" ]; then
      printf '%s' "$label"
      return
    fi
  done < <(host_network_interfaces)
}

service_hosts_for_bind() {
  local bind="$1"
  local label
  case "$bind" in
    127.0.0.1|localhost)
      printf 'local 127.0.0.1\n'
      ;;
    0.0.0.0)
      printf 'local 127.0.0.1\n'
      host_network_interfaces
      ;;
    *)
      label="$(interface_label_for_ip "$bind")"
      printf '%s %s\n' "${label:-host}" "$bind"
      ;;
  esac
}

effective_proxy() {
  local name="$1"
  local device="$2"
  local fallback_bind="$3"
  local fallback_port="$4"
  EFFECTIVE_BIND="$fallback_bind"
  EFFECTIVE_PORT="$fallback_port"
  local listen
  listen="$(device_listen "$name" "$device")"
  if [ -n "$listen" ]; then
    EFFECTIVE_BIND="$(parse_listen_bind "$listen")"
    EFFECTIVE_PORT="$(parse_listen_port "$listen")"
  fi
}

ensure_user() {
  local name="$1"
  local user="$2"
  lxc exec "$name" -- bash -lc "
    set -e
    if ! id '$user' >/dev/null 2>&1; then
      useradd -m -s /bin/bash '$user'
    fi
    install -d -m 700 -o '$user' -g '$user' '/home/$user/.ai-sandbox'
    install -d -m 700 -o '$user' -g '$user' '/home/$user/.ssh'
  "
}

write_box_env() {
  local name="$1"
  local user="$2"
  local port_base="$3"
  local vnc_password="$4"
  local ssh_bind="$5"
  local novnc_bind="$6"
  local cua_bind="$7"
  local path
  path="$(box_config_path "$user")"
  local content
  content="$(cat <<EOF
SANDBOX_USER=${user}
PORT_BASE=${port_base}
VNC_PASSWORD=${vnc_password}
SSH_BIND=${ssh_bind}
NOVNC_BIND=${novnc_bind}
CUA_BIND=${cua_bind}
EOF
)"
  printf '%s\n' "$content" | lxc exec "$name" -- bash -lc "
    set -e
    install -d -m 700 -o '$user' -g '$user' '/home/$user/.ai-sandbox'
    cat > '$path'
    chown '$user:$user' '$path'
    chmod 600 '$path'
  "
  write_host_box_env "$name" "$user" "$port_base" "$vnc_password" "$ssh_bind" "$novnc_bind" "$cua_bind"
}

write_host_box_env() {
  local name="$1"
  local user="$2"
  local port_base="$3"
  local vnc_password="$4"
  local ssh_bind="$5"
  local novnc_bind="$6"
  local cua_bind="$7"
  ensure_state_dirs
  local path
  path="$(host_box_env_path "$name")"
  {
    cat <<EOF
SANDBOX_USER=${user}
PORT_BASE=${port_base}
VNC_PASSWORD=${vnc_password}
SSH_BIND=${ssh_bind}
NOVNC_BIND=${novnc_bind}
CUA_BIND=${cua_bind}
EOF
    if [ -n "${GITHUB_SSH_KEY_TITLE:-}" ] && [ -n "${GITHUB_SSH_KEY_FINGERPRINT:-}" ]; then
      printf 'GITHUB_SSH_KEY_TITLE=%s\n' "$GITHUB_SSH_KEY_TITLE"
      printf 'GITHUB_SSH_KEY_FINGERPRINT=%s\n' "$GITHUB_SSH_KEY_FINGERPRINT"
      if [ -n "${GITHUB_SSH_KEY_ID:-}" ]; then
        printf 'GITHUB_SSH_KEY_ID=%s\n' "$GITHUB_SSH_KEY_ID"
      fi
    fi
  } >"$path"
  chmod 600 "$path"
}

remove_device_if_present() {
  local name="$1"
  local device="$2"
  if lxc config device get "$name" "$device" type >/dev/null 2>&1; then
    lxc config device remove "$name" "$device" >/dev/null
  fi
}

remove_proxy_devices() {
  local name="$1"
  remove_device_if_present "$name" ai-sandbox-ssh
  remove_device_if_present "$name" ai-sandbox-novnc
  remove_device_if_present "$name" ai-sandbox-cua
  remove_device_if_present "$name" host-ssh
  remove_device_if_present "$name" host-novnc
  remove_device_if_present "$name" host-cua
}

configure_base_lxd() {
  local name="$1"
  lxc config set "$name" security.nesting true
  lxc config set "$name" security.syscalls.intercept.mknod true
  lxc config set "$name" security.syscalls.intercept.setxattr true
  lxc config set "$name" boot.autostart true
  if ! lxc config device get "$name" ai-sandbox-gpu type >/dev/null 2>&1; then
    lxc config device add "$name" ai-sandbox-gpu gpu >/dev/null 2>&1 || warn "GPU device not added; doctor will report GPU capability separately"
  fi
}

configure_proxy_devices() {
  local name="$1"
  local ssh_bind="$2"
  local novnc_bind="$3"
  local cua_bind="$4"
  local reassign_if_busy="${5:-no}"

  remove_proxy_devices "$name"

  local busy
  busy="$(busy_port_in_block "$PORT_BASE" "$name")"
  if [ -n "$busy" ]; then
    if [ "$reassign_if_busy" = "yes" ]; then
      local old_port_base="$PORT_BASE"
      PORT_BASE="$(find_free_port_base "$(next_port_block_start "$PORT_BASE")" "$name")"
      ports_from_base "$PORT_BASE"
      warn "Port ${busy} blocked ${name}'s configured block ${old_port_base}-$((old_port_base + 2)); moved to PORT_BASE=${PORT_BASE}"
    else
      die "Port ${busy} is already listening; choose another --port-base"
    fi
  else
    ports_from_base "$PORT_BASE"
  fi

  lxc config device add "$name" ai-sandbox-ssh proxy \
    listen="tcp:${ssh_bind}:${SSH_PORT}" \
    connect="tcp:127.0.0.1:22" >/dev/null
  lxc config device add "$name" ai-sandbox-novnc proxy \
    listen="tcp:${novnc_bind}:${NOVNC_PORT}" \
    connect="tcp:127.0.0.1:6901" >/dev/null
  lxc config device add "$name" ai-sandbox-cua proxy \
    listen="tcp:${cua_bind}:${CUA_PORT}" \
    connect="tcp:127.0.0.1:8000" >/dev/null
}

refresh_vm_vnc_password() {
  local name="$1"
  local user="$2"
  local vnc_password="$3"
  lxc exec "$name" -- bash -lc "
    set -e
    for env_file in /etc/ai-sandbox.env /etc/youart-agent.env; do
      [ -f \"\$env_file\" ] || continue
      sed -i \
        -e 's/^VNC_PW=.*/VNC_PW=${vnc_password}/' \
        -e 's/^CUA_VNC_PASSWORD=.*/CUA_VNC_PASSWORD=${vnc_password}/' \
        \"\$env_file\"
    done
    install -d -m 700 -o '$user' -g '$user' '/home/$user/.vnc'
    printf '%s\n' '${vnc_password}' | runuser -u '$user' -- vncpasswd -f > '/home/$user/.vnc/passwd'
    chown '$user:$user' '/home/$user/.vnc/passwd'
    chmod 600 '/home/$user/.vnc/passwd'
    systemctl restart sandbox-vnc.service sandbox-novnc.service sandbox-cua-server.service 2>/dev/null ||
      systemctl restart youart-vnc.service youart-novnc.service youart-cua-server.service 2>/dev/null || true
  "
}

clear_vm_chromium_locks() {
  local name="$1"
  local user="$2"
  lxc exec "$name" -- runuser -u "$user" -- bash -lc '
    set -e
    cd "$HOME"
    if pgrep -u "$(id -u)" -x chromium >/dev/null 2>&1 ||
      pgrep -u "$(id -u)" -x chrome >/dev/null 2>&1; then
      exit 0
    fi
    for dir in "$HOME/.config/chromium" "$HOME/.config/google-chrome"; do
      [ -d "$dir" ] || continue
      find "$dir" -maxdepth 1 \( -name "SingletonLock" -o -name "SingletonSocket" -o -name "SingletonCookie" \) -delete
    done
  '
}

sync_repo_to_vm() {
  local name="$1"
  local user="$2"
  local repo_dir
  repo_dir="$(repo_dir_for_user "$user")"
  log "Syncing this checkout to ${name}:${repo_dir}"
  lxc exec "$name" -- bash -lc "
    set -e
    install -d -m 755 -o '$user' -g '$user' '$repo_dir'
    find '$repo_dir' -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  "
  tar -C "$REPO_ROOT" \
    --exclude='.git/index.lock' \
    --exclude='.git/objects/pack/tmp_*' \
    --exclude='.DS_Store' \
    -cf - . \
    | lxc exec "$name" -- tar -C "$repo_dir" -xf -
  lxc exec "$name" -- bash -lc "
    chown -R '$user:$user' '/home/$user/.ai-sandbox'
    find '$repo_dir' -type f \( -name 'sandbox' -o -name 'install.sh' -o -name 'uninstall-managed.sh' -o -path '*/scripts/*.sh' \) -exec chmod +x {} + 2>/dev/null || true
  "
}

ensure_box_ssh_key() {
  local name="$1"
  local user="$2"
  require_cmd ssh-keygen
  ensure_state_dirs
  local key_path="${SSH_KEY_DIR}/${name}_ed25519"
  if [ ! -f "$key_path" ]; then
    log "Generating per-box SSH key ${key_path}"
    ssh-keygen -q -t ed25519 -N '' -C "ai-sandbox:${name}" -f "$key_path"
  fi
  chmod 600 "$key_path"
  chmod 644 "${key_path}.pub"
  lxc file push "${key_path}.pub" "$name/tmp/ai-sandbox-authorized-key.pub"
  lxc exec "$name" -- bash -lc "
    set -e
    install -d -m 700 -o '$user' -g '$user' '/home/$user/.ssh'
    touch '/home/$user/.ssh/authorized_keys'
    awk '
      \$0 == \"# >>> ai-sandbox ${name}\" { skip=1; next }
      \$0 == \"# <<< ai-sandbox ${name}\" { skip=0; next }
      !skip { print }
    ' '/home/$user/.ssh/authorized_keys' > '/home/$user/.ssh/authorized_keys.tmp'
    {
      cat '/home/$user/.ssh/authorized_keys.tmp'
      printf '%s\n' '# >>> ai-sandbox ${name}'
      cat /tmp/ai-sandbox-authorized-key.pub
      printf '%s\n' '# <<< ai-sandbox ${name}'
    } > '/home/$user/.ssh/authorized_keys'
    rm -f '/home/$user/.ssh/authorized_keys.tmp'
    chown '$user:$user' '/home/$user/.ssh/authorized_keys'
    chmod 600 '/home/$user/.ssh/authorized_keys'
    rm -f /tmp/ai-sandbox-authorized-key.pub
  "
}

github_state_granted() {
  [ -n "${GITHUB_SSH_KEY_FINGERPRINT:-}" ]
}

github_key_title_for_box() {
  printf 'sandbox-%s' "$1"
}

require_github_auth() {
  require_cmd gh
  if ! gh auth status >/dev/null 2>&1; then
    die "GitHub CLI is not authenticated on the host; run: gh auth login"
  fi
}

ssh_key_fingerprint_from_file() {
  ssh-keygen -lf "$1" -E sha256 | awk '{ print $2 }'
}

ensure_box_github_key() {
  local name="$1"
  local user="$2"
  lxc exec "$name" -- runuser -u "$user" -- bash -lc "
    set -euo pipefail
    install -d -m 700 \"\$HOME/.ssh\"
    if [ ! -f \"\$HOME/.ssh/id_ed25519\" ]; then
      rm -f \"\$HOME/.ssh/id_ed25519.pub\"
      ssh-keygen -q -t ed25519 -N '' -C '${name} sandbox github' -f \"\$HOME/.ssh/id_ed25519\"
    fi
    if [ ! -f \"\$HOME/.ssh/id_ed25519.pub\" ]; then
      ssh-keygen -y -f \"\$HOME/.ssh/id_ed25519\" > \"\$HOME/.ssh/id_ed25519.pub\"
    fi
    chmod 700 \"\$HOME/.ssh\"
    chmod 600 \"\$HOME/.ssh/id_ed25519\"
    chmod 644 \"\$HOME/.ssh/id_ed25519.pub\"
  "
}

box_github_public_key_to_file() {
  local name="$1"
  local user="$2"
  local target="$3"
  lxc exec "$name" -- runuser -u "$user" -- bash -lc 'cat "$HOME/.ssh/id_ed25519.pub"' >"$target"
}

github_find_key_by_fingerprint() {
  local wanted="$1"
  FOUND_GITHUB_SSH_KEY_TITLE=""
  FOUND_GITHUB_SSH_KEY_ID=""
  local list_tmp err_tmp key_tmp
  list_tmp="$(mktemp)"
  err_tmp="$(mktemp)"
  key_tmp="$(mktemp)"
  if ! gh ssh-key list >"$list_tmp" 2>"$err_tmp"; then
    local err
    err="$(tr '\n' ' ' <"$err_tmp")"
    rm -f "$list_tmp" "$err_tmp" "$key_tmp"
    die "Could not list GitHub SSH keys: ${err}"
  fi

  local title key created id kind fp found=1
  while IFS=$'\t' read -r title key created id kind; do
    [ -n "${key:-}" ] || continue
    printf '%s\n' "$key" >"$key_tmp"
    if fp="$(ssh_key_fingerprint_from_file "$key_tmp" 2>/dev/null)" && [ "$fp" = "$wanted" ]; then
      FOUND_GITHUB_SSH_KEY_TITLE="$title"
      FOUND_GITHUB_SSH_KEY_ID="$id"
      found=0
      break
    fi
  done <"$list_tmp"

  rm -f "$list_tmp" "$err_tmp" "$key_tmp"
  return "$found"
}

host_git_email() {
  local email=""
  if command -v git >/dev/null 2>&1; then
    email="$(git config user.email 2>/dev/null || true)"
  fi
  printf '%s' "${email:-fierywaters13@gmail.com}"
}

seed_box_github_known_hosts() {
  local name="$1"
  local user="$2"
  lxc exec "$name" -- runuser -u "$user" -- bash -lc '
    set -euo pipefail
    install -d -m 700 "$HOME/.ssh"
    touch "$HOME/.ssh/known_hosts"
    ssh-keygen -R github.com -f "$HOME/.ssh/known_hosts" >/dev/null 2>&1 || true
    rm -f "$HOME/.ssh/known_hosts.old"
    timeout 30 ssh-keyscan -t rsa,ecdsa,ed25519 github.com >>"$HOME/.ssh/known_hosts" 2>/dev/null
    chmod 600 "$HOME/.ssh/known_hosts"
  '
}

set_box_git_identity() {
  local name="$1"
  local user="$2"
  local git_name="${name} sandbox"
  local git_email
  git_email="$(host_git_email)"
  local quoted_name quoted_email
  quoted_name="$(shell_quote "$git_name")"
  quoted_email="$(shell_quote "$git_email")"
  lxc exec "$name" -- runuser -u "$user" -- bash -lc "
    set -euo pipefail
    git config --global user.name $quoted_name
    git config --global user.email $quoted_email
  "
}

record_github_state() {
  local name="$1"
  local title="$2"
  local fingerprint="$3"
  local key_id="${4:-}"
  load_box_env "$name" || die "No box.env found; run update first"
  GITHUB_SSH_KEY_TITLE="$title"
  GITHUB_SSH_KEY_FINGERPRINT="$fingerprint"
  GITHUB_SSH_KEY_ID="$key_id"
  write_host_box_env "$name" "$SANDBOX_USER" "$PORT_BASE" "$VNC_PASSWORD" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
}

clear_github_state() {
  local name="$1"
  load_box_env "$name" || die "No box.env found; run update first"
  GITHUB_SSH_KEY_TITLE=""
  GITHUB_SSH_KEY_FINGERPRINT=""
  GITHUB_SSH_KEY_ID=""
  write_host_box_env "$name" "$SANDBOX_USER" "$PORT_BASE" "$VNC_PASSWORD" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
}

github_grant() {
  local name="$1"
  require_cmd lxc
  require_cmd ssh-keygen
  require_github_auth
  instance_exists "$name" || die "LXD instance not found: ${name}"
  start_instance "$name"
  wait_for_lxc "$name"
  load_box_env "$name" || die "No box.env found; run update first"

  ensure_box_github_key "$name" "$SANDBOX_USER"

  local public_key_file
  public_key_file="$(mktemp)"
  box_github_public_key_to_file "$name" "$SANDBOX_USER" "$public_key_file"
  local fingerprint title key_id
  fingerprint="$(ssh_key_fingerprint_from_file "$public_key_file")"

  if github_find_key_by_fingerprint "$fingerprint"; then
    title="$FOUND_GITHUB_SSH_KEY_TITLE"
    key_id="$FOUND_GITHUB_SSH_KEY_ID"
    log "GitHub SSH key ${fingerprint} is already registered as ${title}; skipping add"
  else
    title="$(github_key_title_for_box "$name")"
    log "Adding GitHub SSH key ${fingerprint} as ${title}"
    gh ssh-key add "$public_key_file" --title "$title" >/dev/null
    key_id=""
    if github_find_key_by_fingerprint "$fingerprint"; then
      title="${FOUND_GITHUB_SSH_KEY_TITLE:-$title}"
      key_id="$FOUND_GITHUB_SSH_KEY_ID"
    fi
  fi

  seed_box_github_known_hosts "$name" "$SANDBOX_USER"
  set_box_git_identity "$name" "$SANDBOX_USER"
  record_github_state "$name" "$title" "$fingerprint" "$key_id"
  rm -f "$public_key_file"
  log "GitHub access granted for ${name}"
}

github_revoke() {
  local name="$1"
  require_cmd ssh-keygen
  require_github_auth
  if ! load_box_env "$name"; then
    warn "No host box state found for ${name}; nothing to revoke"
    return
  fi
  if ! github_state_granted; then
    warn "No GitHub SSH key recorded for ${name}; nothing to revoke"
    return
  fi

  local fingerprint="$GITHUB_SSH_KEY_FINGERPRINT"
  local title="$GITHUB_SSH_KEY_TITLE"
  if github_find_key_by_fingerprint "$fingerprint"; then
    if [ -z "$FOUND_GITHUB_SSH_KEY_ID" ]; then
      die "Could not determine GitHub SSH key id for ${fingerprint}"
    fi
    log "Revoking GitHub SSH key ${fingerprint} (${title})"
    gh ssh-key delete "$FOUND_GITHUB_SSH_KEY_ID" --yes >/dev/null
  else
    warn "GitHub SSH key ${fingerprint} (${title}) is already gone"
  fi

  clear_github_state "$name"
  log "GitHub access revoked for ${name}"
}

sync_host_codex_profile() {
  local name="$1"
  local user="$2"
  local source="${HOME}/.codex"
  [ -d "$source" ] || return
  local items=()
  local rel
  for rel in auth.json config.toml AGENTS.md AGENTS.override.md hooks.json hooks rules memories; do
    [ -e "$source/$rel" ] && items+=("$rel")
  done
  [ "${#items[@]}" -gt 0 ] || return
  log "Importing host Codex profile files for ${user}"
  lxc exec "$name" -- bash -lc "install -d -m 700 -o '$user' -g '$user' '/home/$user/.codex'"
  tar -C "$source" -cf - "${items[@]}" \
    | lxc exec "$name" -- tar -C "/home/$user/.codex" -xf -
  lxc exec "$name" -- bash -lc "
    chown -R '$user:$user' '/home/$user/.codex'
    chmod 700 '/home/$user/.codex'
    [ ! -f '/home/$user/.codex/auth.json' ] || chmod 600 '/home/$user/.codex/auth.json'
    [ ! -f '/home/$user/.codex/config.toml' ] || chmod 600 '/home/$user/.codex/config.toml'
    find '/home/$user/.codex/hooks' -type f -exec chmod 755 {} + 2>/dev/null || true
  "
}

sync_host_claude_profile() {
  local name="$1"
  local user="$2"
  local source="${HOME}/.claude"
  [ -d "$source" ] || return 0
  local items=()
  local rel
  for rel in .credentials.json settings.json CLAUDE.md agents skills; do
    [ -e "$source/$rel" ] && items+=("$rel")
  done
  if [ "${#items[@]}" -gt 0 ]; then
    log "Importing host Claude profile files for ${user}"
    lxc exec "$name" -- bash -lc "install -d -m 700 -o '$user' -g '$user' '/home/$user/.claude'"
    tar -C "$source" -cf - "${items[@]}" \
      | lxc exec "$name" -- tar -C "/home/$user/.claude" -xf -
  fi

  # ~/.claude.json carries onboarding/account state. Build a minimal one so
  # Claude in the box is signed in and non-interactive, without inheriting
  # host project history.
  if [ -f "${HOME}/.claude.json" ] && command -v jq >/dev/null 2>&1; then
    jq '{hasCompletedOnboarding: true, bypassPermissionsModeAccepted: true}
        + (if .oauthAccount then {oauthAccount: .oauthAccount} else {} end)' \
      "${HOME}/.claude.json" \
      | lxc exec "$name" -- bash -lc "cat > '/home/$user/.claude.json'"
  fi
  lxc exec "$name" -- bash -lc "
    chown -R '$user:$user' '/home/$user/.claude'
    chmod 700 '/home/$user/.claude'
    [ ! -f '/home/$user/.claude/.credentials.json' ] || chmod 600 '/home/$user/.claude/.credentials.json'
    [ ! -f '/home/$user/.claude.json' ] || chown '$user:$user' '/home/$user/.claude.json'
  "
}

run_install() {
  local name="$1"
  local user="$2"
  local uninstall_first="${3:-no}"
  local repo_dir
  repo_dir="$(repo_dir_for_user "$user")"
  if [ "$uninstall_first" = "yes" ]; then
    lxc exec "$name" -- bash -lc "cd '$repo_dir' && bash ./uninstall-managed.sh"
  fi
  lxc exec "$name" -- bash -lc "cd '$repo_dir' && bash ./install.sh"
}

remove_managed_ssh_block() {
  local name="$1"
  remove_managed_ssh_block_from_file "$SSH_CONFIG" "$name"
  remove_managed_ssh_block_from_file "$SSH_MANAGED_CONFIG" "$name"
}

managed_host_alias() {
  printf 'ai-sandbox-%s' "$1"
}

remove_managed_known_host() {
  local name="$1"
  local host_alias
  host_alias="$(managed_host_alias "$name")"
  ensure_state_dirs
  [ -f "$SSH_KNOWN_HOSTS" ] || return
  ssh-keygen -f "$SSH_KNOWN_HOSTS" -R "$host_alias" >/dev/null 2>&1 || true
}

ssh_host_exists_unmanaged() {
  local name="$1"
  [ -f "$SSH_CONFIG" ] || return 1
  awk -v name="$name" '
    $0 == "# >>> ai-sandbox " name { managed=1 }
    $0 == "# <<< ai-sandbox " name { managed=0; next }
    managed { next }
    /^[[:space:]]*Host[[:space:]]+/ {
      for (i=2; i<=NF; i++) if ($i == name) found=1
    }
    END { exit found ? 0 : 1 }
  ' "$SSH_CONFIG"
}

write_ssh_config() {
  local name="$1"
  local user="$2"
  local port="$3"
  local key_path="${SSH_KEY_DIR}/${name}_ed25519"
  local host_alias
  host_alias="$(managed_host_alias "$name")"
  ensure_ssh_include
  touch "$SSH_KNOWN_HOSTS"
  chmod 600 "$SSH_KNOWN_HOSTS"
  remove_managed_ssh_block "$name"
  if ssh_host_exists_unmanaged "$name"; then
    die "~/.ssh/config already has unmanaged Host ${name}; refusing to edit it"
  fi
  {
    printf '\n# >>> ai-sandbox %s\n' "$name"
    printf 'Host %s\n' "$name"
    printf '  HostName 127.0.0.1\n'
    printf '  User %s\n' "$user"
    printf '  Port %s\n' "$port"
    printf '  IdentityFile %s\n' "$key_path"
    printf '  IdentitiesOnly yes\n'
    printf '  UserKnownHostsFile %s\n' "$SSH_KNOWN_HOSTS"
    printf '  HostKeyAlias %s\n' "$host_alias"
    printf '  StrictHostKeyChecking accept-new\n'
    printf '# <<< ai-sandbox %s\n' "$name"
  } >>"$SSH_MANAGED_CONFIG"
}

tcp_check() {
  local port="$1"
  timeout 5 bash -c "</dev/tcp/127.0.0.1/${port}" >/dev/null 2>&1
}

ssh_hostname_matches() {
  local name="$1"
  [ "$(ssh -o BatchMode=yes "$name" hostname)" = "$name" ]
}

doctor() {
  local name="$1"
  local failures=0
  local label
  check_doctor() {
    label="$1"
    shift
    printf '[doctor] %-32s' "$label"
    if "$@" >/tmp/ai-sandbox-doctor.out 2>/tmp/ai-sandbox-doctor.err; then
      printf ' ok\n'
    else
      printf ' FAIL\n' >&2
      sed 's/^/[doctor][stderr] /' /tmp/ai-sandbox-doctor.err >&2 || true
      failures=$((failures + 1))
    fi
  }
  retry_doctor() {
    # 90s window: right after create/update the desktop services have just
    # been (re)started, and a cold vncserver+XFCE start can exceed 30s. The
    # host proxy ports accept instantly, so the HTTP checks are the real
    # "service is up" gate and need the headroom.
    local attempt
    for attempt in $(seq 1 90); do
      if "$@"; then
        return 0
      fi
      sleep 1
    done
    "$@"
  }

  check_doctor "LXD instance" lxc info "$name"
  check_doctor "SSH port ${SSH_PORT}" retry_doctor tcp_check "$SSH_PORT"
  check_doctor "noVNC port ${NOVNC_PORT}" retry_doctor tcp_check "$NOVNC_PORT"
  check_doctor "CUA port ${CUA_PORT}" retry_doctor tcp_check "$CUA_PORT"
  check_doctor "ssh ${name}" ssh -o BatchMode=yes "$name" hostname
  check_doctor "VM hostname" ssh_hostname_matches "$name"
  if github_state_granted; then
    printf '[doctor] %-32s granted (%s)\n' "GitHub access" "$GITHUB_SSH_KEY_FINGERPRINT"
    check_doctor "GitHub SSH auth" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc '
      set -euo pipefail
      status=0
      out="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -T git@github.com 2>&1)" || status=$?
      if [ "$status" -ne 1 ]; then
        printf "%s\n" "$out" >&2
        exit 1
      fi
      if ! printf "%s\n" "$out" | grep -qi "successfully authenticated"; then
        printf "%s\n" "$out" >&2
        exit 1
      fi
    '
  else
    printf '[doctor] %-32s not granted\n' "GitHub access"
  fi
  check_doctor "noVNC HTTP" retry_doctor curl -fsS "http://127.0.0.1:${NOVNC_PORT}/"
  check_doctor "CUA status" retry_doctor curl -fsS "http://127.0.0.1:${CUA_PORT}/status"
  # Doctor's validation scripts run from the checkout that sync_repo_to_vm
  # already placed inside the box, so the code that runs is the code in vm/.
  local vm_doctor
  vm_doctor="$(repo_dir_for_user "$SANDBOX_USER")/vm/doctor"

  check_doctor "VM Codex login" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc "codex login status 2>&1 | grep -q 'Logged in'"
  check_doctor "VM Claude auth" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc '
    set -euo pipefail
    test -s "$HOME/.claude/.credentials.json"
    timeout 120 claude -p "Reply with exactly: ok" | grep -qi "ok"
  '
  check_doctor "VM deskbot" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc '
    set -euo pipefail
    command -v deskbot >/dev/null
    deskbot --help | grep -q -- "--screenshot"
  '
  check_doctor "VM deskbot visual pixels" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc "
    set -euo pipefail
    cd \"\$HOME\"
    image=/tmp/ai-sandbox-deskbot.jpg
    url='data:text/html,%3C!doctype%20html%3E%3Ctitle%3Eai-sandbox%3C/title%3E%3Cbody%20style%3D%22margin%3A0%3Bbackground%3A%23ff00ff%3Bcolor%3Awhite%3Bfont%3A48px%20sans-serif%22%3EAI%20Sandbox%20Deskbot%20Doctor%3C/body%3E'
    deskbot --reset >/tmp/ai-sandbox-deskbot-reset.out
    deskbot --bash \"chromium --new-window '\$url' >/tmp/ai-sandbox-deskbot-chromium.log 2>&1 &\"
    sleep 3
    deskbot --screenshot \"\$image\" >/tmp/ai-sandbox-deskbot-screenshot.out
    python3 '${vm_doctor}/check_pixels.py' \"\$image\"
  "
  check_doctor "VM Codex deskbot smoke" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc "
    set -euo pipefail
    cd \"\$HOME\"
    trace=/tmp/ai-sandbox-codex-deskbot-trace.jsonl
    image=/tmp/ai-sandbox-codex-deskbot.jpg
    rm -f \"\$image\"
    printf '%s\n' '<!doctype html>' '<title>ai-sandbox-codex</title>' '<body style=\"margin:0;background:#ff00ff;color:white;font:48px sans-serif\">AI Sandbox Codex Deskbot Doctor</body>' >/tmp/ai-sandbox-codex-deskbot.html
    # codex exec may clean up background child processes between separate
    # command executions. Keep browser launch, paint wait, and screenshot in
    # one command execution so the browser is alive when pixels are captured.
    prompt='Read ~/.codex/skills/deskbot/SKILL.md if present. Then run one shell command execution that resets stale Chromium windows, opens file:///tmp/ai-sandbox-codex-deskbot.html in Chromium, waits at least 6 seconds for the page to paint, and takes a screenshot exactly at /tmp/ai-sandbox-codex-deskbot.jpg. Do not split the launch and screenshot into separate command executions. The command should be equivalent to: deskbot --reset && deskbot --bash \"chromium --new-window file:///tmp/ai-sandbox-codex-deskbot.html >/tmp/deskbot-chromium.log 2>&1 & sleep 6; deskbot --screenshot /tmp/ai-sandbox-codex-deskbot.jpg\". Do not edit files.'
    timeout 600 codex exec --json --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check \"\$prompt\" </dev/null >\"\$trace\" 2>&1
    python3 '${vm_doctor}/check_agent_trace.py' \"\$trace\" /tmp/ai-sandbox-codex-deskbot-commands.json
    python3 '${vm_doctor}/check_pixels.py' \"\$image\"
  "
  check_doctor "VM Claude deskbot smoke" lxc exec "$name" -- runuser -u "$SANDBOX_USER" -- bash -lc "
    set -euo pipefail
    cd \"\$HOME\"
    image=/tmp/ai-sandbox-claude-deskbot.jpg
    rm -f \"\$image\"
    printf '%s\n' '<!doctype html>' '<title>ai-sandbox-claude</title>' '<body style=\"margin:0;background:#ff00ff;color:white;font:48px sans-serif\">AI Sandbox Claude Deskbot Doctor</body>' >/tmp/ai-sandbox-claude-deskbot.html
    prompt='Read ~/.codex/skills/deskbot/SKILL.md if present. Then run one shell command that resets stale Chromium windows, opens file:///tmp/ai-sandbox-claude-deskbot.html in Chromium, waits at least 6 seconds for the page to paint, and takes a screenshot exactly at /tmp/ai-sandbox-claude-deskbot.jpg. Use deskbot only; do not use ffmpeg, xdotool, or HTTP APIs. The command should be equivalent to: deskbot --reset && deskbot --bash \"chromium --new-window file:///tmp/ai-sandbox-claude-deskbot.html >/tmp/deskbot-chromium.log 2>&1 & sleep 6; deskbot --screenshot /tmp/ai-sandbox-claude-deskbot.jpg\". Do not edit files.'
    timeout 600 claude -p --dangerously-skip-permissions \"\$prompt\" </dev/null >/tmp/ai-sandbox-claude-deskbot.out 2>&1
    python3 '${vm_doctor}/check_pixels.py' \"\$image\"
  "

  rm -f /tmp/ai-sandbox-doctor.out /tmp/ai-sandbox-doctor.err
  [ "$failures" -eq 0 ] || die "${failures} doctor check(s) failed"
}

require_stopped_instance() {
  local name="$1"
  local status
  status="$(instance_status "$name")"
  [ "$status" = "STOPPED" ] || die "${name} must be stopped first; run: sandbox stop ${name}"
}

archive_path_for_name() {
  local name="$1"
  printf '%s/%s.tar.gz' "$ARCHIVE_DIR" "$name"
}

resolve_archive_source() {
  local source="$1"
  if [ -f "$source" ]; then
    printf '%s' "$source"
    return
  fi
  case "$source" in
    */*) die "Archive file not found: ${source}" ;;
  esac
  local default_path
  default_path="$(archive_path_for_name "$source")"
  [ -f "$default_path" ] || die "Archive not found: ${source}; expected ${default_path}"
  printf '%s' "$default_path"
}

parse_clone_bind_args() {
  CLONE_PORT_BASE=""
  CLONE_SSH_BIND="$DEFAULT_BIND"
  CLONE_NOVNC_BIND="$DEFAULT_BIND"
  CLONE_CUA_BIND="$DEFAULT_BIND"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port-base) CLONE_PORT_BASE="${2:-}"; shift 2 ;;
      --bind) CLONE_SSH_BIND="$(normalize_bind "${2:-}")"; CLONE_NOVNC_BIND="$CLONE_SSH_BIND"; CLONE_CUA_BIND="$CLONE_SSH_BIND"; shift 2 ;;
      --ssh-bind) CLONE_SSH_BIND="$(normalize_bind "${2:-}")"; shift 2 ;;
      --novnc-bind) CLONE_NOVNC_BIND="$(normalize_bind "${2:-}")"; shift 2 ;;
      --cua-bind) CLONE_CUA_BIND="$(normalize_bind "${2:-}")"; shift 2 ;;
      --public) CLONE_SSH_BIND="0.0.0.0"; CLONE_NOVNC_BIND="0.0.0.0"; CLONE_CUA_BIND="0.0.0.0"; shift ;;
      --*) die "Unknown option: $1" ;;
      *) die "Unexpected argument: $1" ;;
    esac
  done
  if [ -n "$CLONE_PORT_BASE" ]; then
    validate_port_base "$CLONE_PORT_BASE"
  else
    CLONE_PORT_BASE="$(find_free_port_base "$DEFAULT_PORT_BASE")"
  fi
}

finalize_cloned_box() {
  local name="$1"
  local port_base="$2"
  local ssh_bind="$3"
  local novnc_bind="$4"
  local cua_bind="$5"

  validate_name "$name"
  validate_port_base "$port_base"
  ports_from_base "$port_base"
  check_port_block_free "$port_base" "$name"

  remove_proxy_devices "$name"
  configure_base_lxd "$name"
  reset_cloned_network_identity "$name"
  start_instance "$name"
  wait_for_lxc "$name"
  set_vm_hostname "$name"
  load_box_env "$name" || die "${name} is not a managed sandbox archive/copy; missing box.env"
  ensure_user "$name" "$SANDBOX_USER"

  PORT_BASE="$port_base"
  SSH_BIND="$ssh_bind"
  NOVNC_BIND="$novnc_bind"
  CUA_BIND="$cua_bind"
  ports_from_base "$PORT_BASE"
  VNC_PASSWORD="$(generate_password)"
  write_box_env "$name" "$SANDBOX_USER" "$PORT_BASE" "$VNC_PASSWORD" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
  refresh_vm_vnc_password "$name" "$SANDBOX_USER" "$VNC_PASSWORD"
  clear_vm_chromium_locks "$name" "$SANDBOX_USER"
  configure_proxy_devices "$name" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
  ensure_box_ssh_key "$name" "$SANDBOX_USER"
  write_ssh_config "$name" "$SANDBOX_USER" "$SSH_PORT"
}

cmd_create() {
  require_cmd lxc
  require_cmd ss
  local name=""
  local user="$DEFAULT_USER"
  local user_explicit="no"
  local port_base=""
  local ssh_bind="$DEFAULT_BIND"
  local novnc_bind="$DEFAULT_BIND"
  local cua_bind="$DEFAULT_BIND"
  local from_source=""
  local grant_github="no"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port-base) port_base="${2:-}"; shift 2 ;;
      --user) user="${2:-}"; user_explicit="yes"; shift 2 ;;
      --bind) ssh_bind="$(normalize_bind "${2:-}")"; novnc_bind="$ssh_bind"; cua_bind="$ssh_bind"; shift 2 ;;
      --ssh-bind) ssh_bind="$(normalize_bind "${2:-}")"; shift 2 ;;
      --novnc-bind) novnc_bind="$(normalize_bind "${2:-}")"; shift 2 ;;
      --cua-bind) cua_bind="$(normalize_bind "${2:-}")"; shift 2 ;;
      --public) ssh_bind="0.0.0.0"; novnc_bind="0.0.0.0"; cua_bind="0.0.0.0"; shift ;;
      --github) grant_github="yes"; shift ;;
      --from) from_source="${2:-}"; shift 2 ;;
      -h|--help) command_help create; exit 0 ;;
      --*) die "Unknown create option: $1" ;;
      *) [ -z "$name" ] || die "Unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  validate_user "$user"
  if [ -n "$from_source" ]; then
    [ "$user_explicit" = "no" ] || die "--user is only supported for clean creates; imported boxes keep their archived user"
    instance_exists "$name" && die "LXD instance already exists: ${name}; use update"
    local archive
    archive="$(resolve_archive_source "$from_source")"
    if [ -n "$port_base" ]; then
      validate_port_base "$port_base"
    else
      port_base="$(find_free_port_base "$DEFAULT_PORT_BASE")"
    fi
    check_port_block_free "$port_base"
    log "Importing ${name} from ${archive}"
    lxc import "$archive" "$name"
    finalize_cloned_box "$name" "$port_base" "$ssh_bind" "$novnc_bind" "$cua_bind"
    if [ "$grant_github" = "yes" ]; then
      github_grant "$name"
    fi
    cmd_doctor "$name"
    log "Created ${name}"
    printf 'SSH:   ssh %s\n' "$name"
    printf 'noVNC: http://127.0.0.1:%s/\n' "$NOVNC_PORT"
    return
  fi
  if [ -n "$port_base" ]; then
    validate_port_base "$port_base"
  else
    port_base="$(find_free_port_base "$DEFAULT_PORT_BASE")"
  fi
  ports_from_base "$port_base"
  check_port_block_free "$port_base"
  instance_exists "$name" && die "LXD instance already exists: ${name}; use update"

  log "Launching ${name} from ${DEFAULT_IMAGE}"
  lxc launch "$DEFAULT_IMAGE" "$name"
  start_instance "$name"
  wait_for_lxc "$name"
  configure_base_lxd "$name"
  set_vm_hostname "$name"
  ensure_user "$name" "$user"
  local pw
  pw="$(generate_password)"
  write_box_env "$name" "$user" "$port_base" "$pw" "$ssh_bind" "$novnc_bind" "$cua_bind"
  configure_proxy_devices "$name" "$ssh_bind" "$novnc_bind" "$cua_bind"
  sync_repo_to_vm "$name" "$user"
  ensure_box_ssh_key "$name" "$user"
  sync_host_codex_profile "$name" "$user"
  sync_host_claude_profile "$name" "$user"
  run_install "$name" "$user" no
  write_ssh_config "$name" "$user" "$SSH_PORT"
  if [ "$grant_github" = "yes" ]; then
    github_grant "$name"
  fi
  cmd_doctor "$name"
  log "Created ${name}"
  printf 'SSH:   ssh %s\n' "$name"
  printf 'noVNC: http://127.0.0.1:%s/\n' "$NOVNC_PORT"
}

cmd_update() {
  require_cmd lxc
  require_cmd ss
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  start_instance "$name"
  wait_for_lxc "$name"
  set_vm_hostname "$name"
  load_box_env "$name" || die "No box.env found for ${name}; this box predates managed config"
  ensure_user "$name" "$SANDBOX_USER"
  configure_base_lxd "$name"
  configure_proxy_devices "$name" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND" yes
  write_box_env "$name" "$SANDBOX_USER" "$PORT_BASE" "$VNC_PASSWORD" "$SSH_BIND" "$NOVNC_BIND" "$CUA_BIND"
  sync_repo_to_vm "$name" "$SANDBOX_USER"
  ensure_box_ssh_key "$name" "$SANDBOX_USER"
  sync_host_codex_profile "$name" "$SANDBOX_USER"
  sync_host_claude_profile "$name" "$SANDBOX_USER"
  run_install "$name" "$SANDBOX_USER" yes
  write_ssh_config "$name" "$SANDBOX_USER" "$SSH_PORT"
  cmd_doctor "$name"
  log "Updated ${name}"
}

cmd_start() {
  require_cmd lxc
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  local status
  status="$(instance_status "$name")"
  if [ "$status" = "STOPPED" ]; then
    log "Starting ${name}"
    lxc start "$name"
  else
    log "${name} is already ${status}"
  fi
  wait_for_lxc "$name"
  load_box_env "$name" || die "No box.env found; run update first"
  write_ssh_config "$name" "$SANDBOX_USER" "$SSH_PORT"
  local attempt
  for attempt in $(seq 1 30); do
    if tcp_check "$SSH_PORT"; then
      break
    fi
    sleep 1
  done
  tcp_check "$SSH_PORT" || die "SSH port did not become ready: ${SSH_PORT}"
  printf 'SSH:   ssh %s\n' "$name"
  printf 'noVNC: http://127.0.0.1:%s/\n' "$NOVNC_PORT"
}

cmd_stop() {
  require_cmd lxc
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  local status
  status="$(instance_status "$name")"
  if [ "$status" = "STOPPED" ]; then
    log "${name} is already STOPPED"
    return
  fi
  log "Stopping ${name}"
  lxc stop "$name"
  log "Stopped ${name}"
}

cmd_copy() {
  require_cmd lxc
  require_cmd ss
  local source="${1:-}"
  local dest="${2:-}"
  [ -n "$source" ] || die "Missing SOURCE"
  [ -n "$dest" ] || die "Missing DEST"
  shift 2
  validate_name "$source"
  validate_name "$dest"
  instance_exists "$source" || die "LXD instance not found: ${source}"
  instance_exists "$dest" && die "LXD instance already exists: ${dest}"
  require_stopped_instance "$source"
  parse_clone_bind_args "$@"

  log "Copying ${source} to ${dest}"
  lxc copy "$source" "$dest" --instance-only
  finalize_cloned_box "$dest" "$CLONE_PORT_BASE" "$CLONE_SSH_BIND" "$CLONE_NOVNC_BIND" "$CLONE_CUA_BIND"
  cmd_doctor "$dest"
  log "Copied ${source} to ${dest}"
  printf 'SSH:   ssh %s\n' "$dest"
  printf 'noVNC: http://127.0.0.1:%s/\n' "$NOVNC_PORT"
}

cmd_export() {
  require_cmd lxc
  local name="${1:-}"
  local target="${2:-}"
  [ -n "$name" ] || die "Missing NAME"
  [ "$#" -le 2 ] || die "Unexpected argument: $3"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  require_stopped_instance "$name"
  ensure_state_dirs
  if [ -z "$target" ]; then
    target="$(archive_path_for_name "$name")"
  fi
  mkdir -p "$(dirname "$target")"
  local tmp="${target}.tmp"
  rm -f "$tmp"
  log "Exporting ${name} to ${target}"
  lxc export "$name" "$tmp" --instance-only
  mv -f "$tmp" "$target"
  chmod 600 "$target"
  ls -lh "$target"
}

cmd_github() {
  local name=""
  local revoke="no"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --revoke) revoke="yes"; shift ;;
      -h|--help) command_help github; exit 0 ;;
      --*) die "Unknown github option: $1" ;;
      *) [ -z "$name" ] || die "Unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  if [ "$revoke" = "yes" ]; then
    github_revoke "$name"
  else
    github_grant "$name"
  fi
}

cmd_doctor() {
  require_cmd lxc
  require_cmd curl
  local name=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) command_help doctor; exit 0 ;;
      --*) die "Unknown doctor option: $1" ;;
      *) [ -z "$name" ] || die "Unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  load_box_env "$name" || die "No box.env found; run update first"
  write_ssh_config "$name" "$SANDBOX_USER" "$SSH_PORT"
  doctor "$name"
}

cmd_view() {
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  load_box_env "$name" || die "No box.env found; run update first"
  printf 'http://127.0.0.1:%s/\n' "$NOVNC_PORT"
}

cmd_ssh() {
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  shift || true
  validate_name "$name"
  load_box_env "$name" || die "No box.env found; run update first"
  write_ssh_config "$name" "$SANDBOX_USER" "$SSH_PORT"
  if [ "${1:-}" = "--" ]; then shift; fi
  if [ "$#" -gt 0 ]; then
    ssh "$name" "$@"
  else
    ssh "$name"
  fi
}

network_labels_csv() {
  local bind="$1"
  local label addr out=""
  while read -r label addr; do
    [ -n "$label" ] || continue
    [ "$addr" = "127.0.0.1" ] && continue
    if [ -z "$out" ]; then
      out="$label"
    else
      out="${out},${label}"
    fi
  done < <(service_hosts_for_bind "$bind")
  printf '%s' "$out"
}

summarize_exposure() {
  local ssh_bind="$1"
  local novnc_bind="$2"
  local cua_bind="$3"
  local service bind labels first label service_csv out pair
  local -a services=()
  local -a label_sets=()

  for service in ssh noVNC CUA; do
    case "$service" in
      ssh) bind="$ssh_bind" ;;
      noVNC) bind="$novnc_bind" ;;
      CUA) bind="$cua_bind" ;;
    esac
    labels="$(network_labels_csv "$bind")"
    if [ -n "$labels" ]; then
      services+=("$service")
      label_sets+=("$labels")
    fi
  done

  if [ "${#services[@]}" -eq 0 ]; then
    printf 'local'
    return
  fi

  first="${label_sets[0]}"
  for label in "${label_sets[@]}"; do
    if [ "$label" != "$first" ]; then
      out=""
      for service in "${!services[@]}"; do
        pair="${services[$service]} on ${label_sets[$service]}"
        if [ -z "$out" ]; then
          out="$pair"
        else
          out="${out}; ${pair}"
        fi
      done
      printf '%s' "$out"
      return
    fi
  done

  service_csv="$(IFS=,; printf '%s' "${services[*]}")"
  printf '%s on %s' "$service_csv" "$first"
}

first_service_addr() {
  local bind="$1"
  local label addr
  while read -r label addr; do
    [ -n "$label" ] || continue
    printf '%s' "$addr"
    return
  done < <(service_hosts_for_bind "$bind")
}

print_ssh_detail() {
  local name="$1"
  local user="$2"
  local bind="$3"
  local port="$4"
  local key_path="$5"
  local label addr
  while read -r label addr; do
    [ -n "$label" ] || continue
    if [ "$addr" = "127.0.0.1" ]; then
      printf '  local: %s (%s:%s)\n' "ssh $name" "$addr" "$port"
    else
      printf '  %s: ssh -i %s -p %s %s@%s\n' "$label" "$key_path" "$port" "$user" "$addr"
    fi
  done < <(service_hosts_for_bind "$bind")
}

print_url_detail() {
  local bind="$1"
  local port="$2"
  local label addr
  while read -r label addr; do
    [ -n "$label" ] || continue
    printf '  %s: http://%s:%s/\n' "$label" "$addr" "$port"
  done < <(service_hosts_for_bind "$bind")
}

print_list_row() {
  local name="$1"
  local status="$2"
  if load_box_env "$name" >/dev/null 2>&1; then
    effective_proxy "$name" ai-sandbox-ssh "$SSH_BIND" "$SSH_PORT"
    local ssh_bind="$EFFECTIVE_BIND"
    local ssh_port="$EFFECTIVE_PORT"
    effective_proxy "$name" ai-sandbox-novnc "$NOVNC_BIND" "$NOVNC_PORT"
    local novnc_bind="$EFFECTIVE_BIND"
    local novnc_port="$EFFECTIVE_PORT"
    effective_proxy "$name" ai-sandbox-cua "$CUA_BIND" "$CUA_PORT"
    local cua_bind="$EFFECTIVE_BIND"
    local cua_port="$EFFECTIVE_PORT"
    local novnc_host exposure
    novnc_host="$(first_service_addr "$novnc_bind")"
    exposure="$(summarize_exposure "$ssh_bind" "$novnc_bind" "$cua_bind")"
    printf '%-28s %-10s %-24s %-28s %s\n' \
      "$name" "$status" "ssh $name" "http://${novnc_host}:${novnc_port}/" "$exposure"
  else
    printf '%-28s %-10s %-24s %-28s %s\n' "$name" "$status" "-" "-" "unmanaged"
  fi
}

print_list_detail() {
  local name="$1"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  local status
  status="$(instance_status "$name")"

  printf 'name: %s\n' "$name"
  printf 'status: %s\n' "$status"
  if ! load_box_env "$name" >/dev/null 2>&1; then
    printf 'managed: no\n'
    printf 'box.env: missing\n'
    return
  fi

  effective_proxy "$name" ai-sandbox-ssh "$SSH_BIND" "$SSH_PORT"
  local ssh_bind="$EFFECTIVE_BIND"
  local ssh_port="$EFFECTIVE_PORT"
  effective_proxy "$name" ai-sandbox-novnc "$NOVNC_BIND" "$NOVNC_PORT"
  local novnc_bind="$EFFECTIVE_BIND"
  local novnc_port="$EFFECTIVE_PORT"
  effective_proxy "$name" ai-sandbox-cua "$CUA_BIND" "$CUA_PORT"
  local cua_bind="$EFFECTIVE_BIND"
  local cua_port="$EFFECTIVE_PORT"
  local key_path="${SSH_KEY_DIR}/${name}_ed25519"
  local host_alias
  host_alias="$(managed_host_alias "$name")"

  printf 'user: %s\n\n' "$SANDBOX_USER"
  printf 'ssh:\n'
  printf '  alias: ssh %s\n' "$name"
  printf '  private key path: %s\n' "$key_path"
  printf '  known hosts: %s\n' "$SSH_KNOWN_HOSTS"
  printf '  host key alias: %s\n' "$host_alias"
  print_ssh_detail "$name" "$SANDBOX_USER" "$ssh_bind" "$ssh_port" "$key_path"
  printf '\nnoVNC:\n'
  print_url_detail "$novnc_bind" "$novnc_port"
  printf '\nCUA:\n'
  print_url_detail "$cua_bind" "$cua_port"
  printf '\nconfig:\n'
  printf '  ports: ssh=%s novnc=%s cua=%s\n' "$ssh_port" "$novnc_port" "$cua_port"
  printf '  binds: ssh=%s novnc=%s cua=%s\n' "$ssh_bind" "$novnc_bind" "$cua_bind"
}

cmd_list() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    command_help list
    exit 0
  fi
  [ "$#" -le 1 ] || die "Unexpected argument: $2"
  if [ "$#" -eq 1 ]; then
    case "$1" in
      --*) die "Unknown list option: $1" ;;
    esac
    print_list_detail "$1"
    return
  fi

  printf '%-28s %-10s %-24s %-28s %s\n' "NAME" "STATUS" "SSH" "NOVNC" "EXPOSURE"
  local line name status
  while IFS=, read -r name status _rest; do
    [ -n "$name" ] || continue
    print_list_row "$name" "$status"
  done < <(lxc list --format csv -c ns)
}

cmd_destroy() {
  local name="${1:-}"
  [ -n "$name" ] || die "Missing NAME"
  validate_name "$name"
  instance_exists "$name" || die "LXD instance not found: ${name}"
  printf 'This will permanently delete LXD instance %s, revoke its recorded GitHub key if granted, and remove its managed SSH config, known-host entry, and keypair.\n' "$name" >&2
  printf 'Type the exact box name to continue: ' >&2
  local answer
  read -r answer
  [ "$answer" = "$name" ] || die "Confirmation did not match; aborting"
  GITHUB_SSH_KEY_TITLE=""
  GITHUB_SSH_KEY_FINGERPRINT=""
  GITHUB_SSH_KEY_ID=""
  if load_box_env "$name" >/dev/null 2>&1 && github_state_granted; then
    github_revoke "$name"
  fi
  log "Removing managed SSH config block for ${name}"
  remove_managed_ssh_block "$name"
  log "Removing managed SSH known-host entry for ${name}"
  remove_managed_known_host "$name"
  log "Removing per-box SSH keypair for ${name}"
  rm -f "${SSH_KEY_DIR}/${name}_ed25519" "${SSH_KEY_DIR}/${name}_ed25519.pub"
  log "Removing host box config mirror for ${name}"
  rm -f "$(host_box_env_path "$name")"
  log "Deleting LXD instance ${name}"
  lxc delete "$name" --force
  log "Verifying ${name} is gone"
  if instance_exists "$name"; then
    die "LXD instance still exists after delete: ${name}"
  fi
  log "Destroyed ${name}"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    create) cmd_create "$@" ;;
    update) cmd_update "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    copy|cp) cmd_copy "$@" ;;
    export) cmd_export "$@" ;;
    github) cmd_github "$@" ;;
    doctor) cmd_doctor "$@" ;;
    view) cmd_view "$@" ;;
    ssh) cmd_ssh "$@" ;;
    list) cmd_list "$@" ;;
    destroy) cmd_destroy "$@" ;;
    help|-h|--help) command_help "${1:-}" ;;
    *) die "Unknown command: ${cmd}" ;;
  esac
}

main "$@"
