[Unit]
Description=AI Sandbox CUA Computer Server
After=sandbox-vnc.service
Requires=sandbox-vnc.service

[Service]
User=@AGENT_USER@
EnvironmentFile=/etc/ai-sandbox.env
WorkingDirectory=@AGENT_HOME@
ExecStart=/usr/local/bin/sandbox-cua-server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
